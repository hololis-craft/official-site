---
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/hololis.css";

interface FooterLink {
  href: string;
  label: string;
}
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  footerLinks?: FooterLink[];
}
const {
  title,
  description = "ホロリスくらふとは、ホロライブリスナー同士が交流するファン運営のMinecraftサーバー。Java・統合版クロスプレイ対応で、独自のホロメン頭ガチャや経済システム、ミニゲームなどが楽しめます。",
  ogImage = "/assets/floating-island-night.jpg",
  ogType = "website",
  footerLinks,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteName = "ホロリスくらふと";
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800;900&family=Baloo+2:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var KEY = "hololis-theme";
        var saved = null;
        try {
          saved = localStorage.getItem(KEY);
        } catch (e) {}
        var theme = saved === "light" || saved === "dark" ? saved : "dark";
        document.documentElement.setAttribute("data-theme", theme);

        function sync() {
          var cur = document.documentElement.getAttribute("data-theme");
          var btns = document.querySelectorAll("[data-theme-btn]");
          for (var i = 0; i < btns.length; i++) {
            btns[i].classList.toggle(
              "active",
              btns[i].getAttribute("data-theme-btn") === cur,
            );
          }
        }

        window.setTheme = function (t) {
          if (t !== "light" && t !== "dark") return;
          try {
            localStorage.setItem(KEY, t);
          } catch (e) {}
          document.documentElement.setAttribute("data-theme", t);
          sync();
        };

        window.toggleNav = function () {
          var nav = document.querySelector(".nav");
          if (!nav) return;
          var btn = nav.querySelector(".nav-burger");
          var open = nav.classList.toggle("open");
          if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", sync);
        } else {
          sync();
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <SiteNav />
    <slot />
    <SiteFooter links={footerLinks} />
  </body>
</html>
