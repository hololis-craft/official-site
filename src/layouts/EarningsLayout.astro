---
import EarningsNav from "../components/EarningsNav.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  active?: "top" | "rules" | "guides";
}
const {
  title,
  description = "特別企画「金策サバイバル」の公式特設サイト。仕事・取引・株・カジノ・イベント、すべては最終日の総資産のために。",
  ogImage = "/assets/kinsaku-shop.jpeg",
  ogType = "website",
  active,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteName = "ホロリスくらふと 金策サバイバル";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#101010" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Baloo+2:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <EarningsNav active={active} />
    <slot />
    <footer class="earn-footer">
      <div class="earn-footer-inner">
        <div class="earn-footer-brand">
          <b>ホロリスくらふと</b>
          <span
            >非公式ファンサービスです。カバー株式会社およびホロライブプロダクションとは一切関係ありません。</span
          >
        </div>
        <div class="earn-footer-links">
          <a href="/">通常サイトへ</a>
          <a href="/earnings">TOP</a>
          <a href="/earnings/rules">ルール</a>
          <a href="/earnings#guides">ガイド</a>
          <a href="https://discord.gg/DuhcMGGw4">Discord</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --earn-bg: #101010;
    --earn-bg-2: #0b0b0b;
    --earn-bg-3: #171509;
    --earn-text: #e8e2d4;
    --earn-text-muted: rgba(232, 226, 212, 0.7);
    --earn-text-dim: rgba(232, 226, 212, 0.5);
    --earn-gold: #c9a227;
    --earn-gold-bright: #e6c554;
    --earn-line: rgba(201, 162, 39, 0.35);
    --earn-line-soft: rgba(201, 162, 39, 0.2);
    --earn-line-hair: rgba(232, 226, 212, 0.12);
  }

  html,
  body {
    background: var(--earn-bg);
    color: var(--earn-text);
  }
  body {
    margin: 0;
    font-family: "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", sans-serif;
    font-weight: 500;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  ::selection {
    background: rgba(201, 162, 39, 0.4);
    color: #fff;
  }

  .earn-mono {
    font-family: "JetBrains Mono", monospace;
    letter-spacing: 0.06em;
  }

  .earn-section-eyebrow {
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .earn-section-eyebrow > .label {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.34em;
    color: var(--earn-gold);
  }
  .earn-section-eyebrow > .rule {
    flex: 1;
    height: 1px;
    background: rgba(201, 162, 39, 0.25);
  }
  .earn-h2 {
    font-size: 40px;
    font-weight: 900;
    margin: 18px 0 0;
    line-height: 1.25;
  }
  .earn-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .earn-btn-primary {
    display: inline-block;
    background: var(--earn-gold);
    color: #121212;
    font-weight: 900;
    font-size: 15px;
    padding: 16px 36px;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }
  .earn-btn-primary:hover {
    background: var(--earn-gold-bright);
    transform: translateY(-1px);
  }
  .earn-btn-ghost {
    display: inline-block;
    border: 1.5px solid rgba(232, 226, 212, 0.4);
    color: var(--earn-text);
    font-weight: 700;
    font-size: 14px;
    padding: 14.5px 30px;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .earn-btn-ghost:hover {
    border-color: var(--earn-gold);
    color: var(--earn-gold);
  }
  .earn-btn-outline {
    display: inline-block;
    border: 1.5px solid var(--earn-gold);
    color: var(--earn-gold);
    font-weight: 900;
    font-size: 15px;
    padding: 14.5px 32px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .earn-btn-outline:hover {
    background: var(--earn-gold);
    color: #121212;
  }

  .earn-footer {
    background: var(--earn-bg-2);
    border-top: 1px solid rgba(232, 226, 212, 0.08);
    color: var(--earn-text-dim);
  }
  .earn-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 28px 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
  }
  .earn-footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 640px;
    flex: 1 1 260px;
  }
  .earn-footer-brand b {
    color: var(--earn-text);
    font-size: 13.5px;
    font-weight: 900;
  }
  .earn-footer-links {
    display: flex;
    gap: 20px;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .earn-footer-links a {
    color: var(--earn-text-muted);
    text-decoration: none;
    font-weight: 700;
  }
  .earn-footer-links a:hover {
    color: var(--earn-gold);
  }

  /* ============ shared photo ============ */
  .earn-photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(201, 162, 39, 0.3);
    background: var(--earn-bg-2);
  }
  .earn-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .earn-photo figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    background: rgba(11, 11, 11, 0.85);
    color: var(--earn-text);
    font-size: 11px;
    font-weight: 700;
    padding: 8px 16px;
    letter-spacing: 0.1em;
  }

  /* ============ shared guide-page styles ============ */
  .guide-hero {
    padding: 76px 0 56px;
    border-bottom: 1px solid rgba(201, 162, 39, 0.3);
  }
  .guide-crumb {
    font-size: 12px;
    font-weight: 700;
    color: rgba(232, 226, 212, 0.45);
    letter-spacing: 0.1em;
    font-family: "JetBrains Mono", monospace;
  }
  .guide-crumb a {
    text-decoration: none;
    color: inherit;
  }
  .guide-crumb a:hover {
    color: var(--earn-gold);
  }
  .guide-crumb > span.current {
    color: var(--earn-gold);
  }
  .guide-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.34em;
    color: var(--earn-gold);
    margin-top: 34px;
  }
  .guide-title {
    font-size: 54px;
    font-weight: 900;
    line-height: 1.15;
    margin: 16px 0 0;
  }
  .guide-underline {
    width: 72px;
    height: 3px;
    background: var(--earn-gold);
    margin-top: 26px;
  }
  .guide-lead {
    font-size: 15px;
    font-weight: 500;
    line-height: 2.1;
    color: rgba(232, 226, 212, 0.72);
    margin: 20px 0 0;
    max-width: 720px;
  }

  .guide-body {
    padding: 76px 0 56px;
  }
  .guide-body h2 {
    font-size: 30px;
    font-weight: 900;
    margin: 56px 0 0;
    display: flex;
    align-items: baseline;
    gap: 16px;
    line-height: 1.3;
  }
  .guide-body h2:first-child {
    margin-top: 0;
  }
  .guide-body h2::before {
    content: "";
    width: 26px;
    height: 3px;
    background: var(--earn-gold);
    display: inline-block;
    transform: translateY(-6px);
    flex: 0 0 auto;
  }
  .guide-body h3 {
    font-size: 20px;
    font-weight: 900;
    margin: 34px 0 0;
    color: var(--earn-text);
  }
  .guide-body p {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 2;
    color: rgba(232, 226, 212, 0.78);
    margin: 14px 0 0;
  }
  .guide-body ul,
  .guide-body ol {
    padding-left: 20px;
    margin: 14px 0 0;
  }
  .guide-body li {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.95;
    color: rgba(232, 226, 212, 0.78);
    margin: 6px 0;
  }
  .guide-body li::marker {
    color: var(--earn-gold);
  }
  .guide-body code,
  .guide-body kbd {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    background: rgba(201, 162, 39, 0.1);
    border: 1px solid rgba(201, 162, 39, 0.2);
    color: var(--earn-gold-bright);
    padding: 2px 8px;
  }
  .guide-body pre {
    background: #0a0a0a;
    border-left: 3px solid var(--earn-gold);
    padding: 18px 22px;
    margin: 18px 0 0;
    overflow-x: auto;
  }
  .guide-body pre code {
    background: transparent;
    border: none;
    color: var(--earn-text);
    padding: 0;
    font-size: 13.5px;
    line-height: 1.8;
  }
  .guide-body b,
  .guide-body strong {
    color: var(--earn-gold);
    font-weight: 900;
  }
  .guide-body a {
    color: var(--earn-gold);
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 162, 39, 0.4);
  }
  .guide-body a:hover {
    border-bottom-color: var(--earn-gold);
  }

  /* callout box */
  .guide-callout {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 20px;
    padding: 22px 26px;
    margin: 24px 0 0;

    border: 1px solid rgba(201, 162, 39, 0.35);
    background: rgba(201, 162, 39, 0.05);
  }
  .guide-callout .cal-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--earn-gold);
    letter-spacing: 0.2em;
    padding-top: 2px;
  }
  .guide-callout p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.95;
    color: rgba(232, 226, 212, 0.85);
  }
  .guide-callout.is-warn {
    border-color: rgba(240, 120, 60, 0.4);
    background: rgba(240, 120, 60, 0.06);
  }
  .guide-callout.is-warn .cal-label {
    color: #f0783c;
  }

  /* command list — inline commands with descriptions */
  .guide-cmd-list {
    margin: 22px 0 0;
    border-top: 1px solid var(--earn-line-hair);
  }
  .guide-cmd-list .row {
    display: grid;
    grid-template-columns: minmax(220px, 0.9fr) 1.6fr;
    gap: 20px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--earn-line-hair);
    align-items: baseline;
  }
  .guide-cmd-list .row code {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--earn-gold-bright);
    background: transparent;
    border: none;
    padding: 0;
  }
  .guide-cmd-list .row .desc {
    font-size: 13.5px;
    font-weight: 500;
    color: rgba(232, 226, 212, 0.78);
    line-height: 1.85;
  }

  /* related links footer */
  .guide-related {
    padding: 30px 0;
  }
  .guide-related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(201, 162, 39, 0.22);
    border: 1px solid rgba(201, 162, 39, 0.22);
    margin-top: 24px;
  }
  .guide-related-grid a {
    background: var(--earn-bg-2);
    padding: 22px 22px 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background 0.15s ease;
  }
  .guide-related-grid a:hover {
    background: var(--earn-bg-3);
  }
  .guide-related-grid a.is-current {
    background: rgba(201, 162, 39, 0.08);
  }
  .guide-related-grid a .lbl {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--earn-gold);
  }
  .guide-related-grid a .ttl {
    font-size: 17px;
    font-weight: 900;
  }
  .guide-related-grid a .lead {
    font-size: 12.5px;
    font-weight: 500;
    color: rgba(232, 226, 212, 0.55);
    line-height: 1.85;
  }

  @media (max-width: 820px) {
    .earn-container {
      padding: 0 22px;
    }
    .earn-footer-inner {
      padding: 22px;
    }
    .earn-h2 {
      font-size: 28px;
    }
    .guide-title {
      font-size: 36px;
    }
    .guide-body h2 {
      font-size: 24px;
    }
    .guide-body pre {
      font-size: 12px;
    }
    .guide-cmd-list .row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .guide-related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
