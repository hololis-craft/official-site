---
interface Props {
  active?: "top" | "rules" | "guides" | "market" | "ranking";
}
const { active } = Astro.props;

const links = [
  { href: "/earnings#overview", label: "概要", key: "top" },
  { href: "/earnings#earn", label: "金策手段", key: "top-earn" },
  { href: "/earnings/rules", label: "ルール", key: "rules" },
  { href: "/earnings#guides", label: "ガイド", key: "guides" },
  { href: "/earnings/market", label: "マーケット", key: "market" },
  { href: "/earnings/ranking", label: "ランキング", key: "ranking" },
];
---

<nav class="earn-nav">
  <a class="earn-nav-logo" href="/earnings">
    <span class="earn-nav-mark">
      <span></span><span></span><span></span><span></span>
    </span>
    <span class="earn-nav-tag">ホロリス金策サバイバル 2026</span>
  </a>
  <button
    class="earn-nav-burger"
    type="button"
    aria-label="メニュー"
    aria-expanded="false"
    onclick="toggleEarnNav()"
  >
    <span></span><span></span><span></span>
  </button>
  <div class="earn-nav-menu" id="earn-nav-menu">
    <div class="earn-nav-links">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              (active === "rules" && l.key === "rules") ||
              (active === "guides" && l.key === "guides") ||
              (active === "market" && l.key === "market") ||
              (active === "ranking" && l.key === "ranking")
                ? "is-active"
                : "",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
    <a class="earn-nav-cta" href="https://discord.gg/DuhcMGGw4"
      >Discordで最新情報</a
    >
  </div>
</nav>

<script is:inline>
  window.toggleEarnNav = function () {
    var nav = document.querySelector(".earn-nav");
    if (!nav) return;
    var btn = nav.querySelector(".earn-nav-burger");
    var open = nav.classList.toggle("open");
    if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
  };
</script>

<style>
  .earn-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    height: 70px;
    padding: 0 48px;
    border-bottom: 1px solid rgba(201, 162, 39, 0.35);
    background: #101010;
    color: #e8e2d4;
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(6px);
  }
  .earn-nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 900;
    font-size: 15px;
    white-space: nowrap;
    letter-spacing: 0.06em;
    color: inherit;
    text-decoration: none;
  }
  .earn-nav-mark {
    display: grid;
    grid-template-columns: repeat(2, 7px);
    grid-template-rows: repeat(2, 7px);
    gap: 2px;
  }
  .earn-nav-mark > span {
    display: block;
  }
  .earn-nav-mark > span:nth-child(1),
  .earn-nav-mark > span:nth-child(4) {
    background: #c9a227;
  }
  .earn-nav-mark > span:nth-child(2),
  .earn-nav-mark > span:nth-child(3) {
    background: rgba(201, 162, 39, 0.4);
  }
  .earn-nav-tag {
    font-family: "JetBrains Mono", monospace;
    color: #c9a227;
    letter-spacing: 0.22em;
    font-size: 12px;
    font-weight: 700;
    margin-left: 6px;
  }
  .earn-nav-menu {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-weight: 700;
    font-size: 13.5px;
    color: rgba(232, 226, 212, 0.7);
    align-items: center;
  }
  .earn-nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .earn-nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
    padding-bottom: 2px;
  }
  .earn-nav-links a:hover {
    color: #c9a227;
  }
  .earn-nav-links a.is-active {
    color: #c9a227;
    border-bottom: 2px solid #c9a227;
  }
  .earn-nav-cta {
    border: 1.5px solid #c9a227;
    color: #c9a227;
    font-weight: 900;
    font-size: 13.5px;
    padding: 10px 24px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .earn-nav-cta:hover {
    background: #c9a227;
    color: #121212;
  }
  .earn-nav-burger {
    display: none;
    background: transparent;
    border: 1px solid rgba(201, 162, 39, 0.4);
    color: #c9a227;
    width: 40px;
    height: 40px;
    padding: 0;
    cursor: pointer;
    margin-left: auto;
    position: relative;
  }
  .earn-nav-burger span {
    display: block;
    position: absolute;
    left: 9px;
    right: 9px;
    height: 2px;
    background: #c9a227;
  }
  .earn-nav-burger span:nth-child(1) {
    top: 12px;
  }
  .earn-nav-burger span:nth-child(2) {
    top: 19px;
  }
  .earn-nav-burger span:nth-child(3) {
    top: 26px;
  }

  @media (max-width: 820px) {
    .earn-nav {
      padding: 0 22px;
      gap: 14px;
      flex-wrap: wrap;
      height: auto;
      min-height: 64px;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .earn-nav-tag {
      display: none;
    }
    .earn-nav-burger {
      display: block;
    }
    .earn-nav-menu {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 8px 0 4px;
      border-top: 1px solid rgba(201, 162, 39, 0.25);
    }
    .earn-nav.open .earn-nav-menu {
      display: flex;
    }
    .earn-nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }
    .earn-nav-links a {
      padding: 12px 4px;
      border-bottom: 1px solid rgba(201, 162, 39, 0.14);
    }
    .earn-nav-links a.is-active {
      border-bottom-color: #c9a227;
    }
    .earn-nav-cta {
      text-align: center;
    }
  }
</style>
