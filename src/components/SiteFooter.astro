---
interface FooterLink {
  href: string;
  label: string;
}
interface Props {
  links?: FooterLink[];
}
const {
  links = [
    { href: "/systems", label: "システム" },
    { href: "/history", label: "歴史" },
    { href: "#", label: "X (Twitter)" },
  ],
} = Astro.props;
---

<footer class="footer">
  <b>ホロリスくらふと</b>
  <span>
    <a href="https://hololivepro.com/terms/">二次創作ガイドライン</a
    >に基づき制作された非公式ファンサービスです。
    カバー株式会社およびホロライブプロダクションとは一切関係ありません。
  </span>
  <div class="footer-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
</footer>
