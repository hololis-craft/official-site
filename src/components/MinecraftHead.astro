---
interface Props {
  b64: string;
  size?: number;
  scale?: number;
  label?: string;
  hoverSpin?: boolean;
  class?: string;
}
const {
  b64,
  size = 96,
  scale = 0.62,
  label = "Minecraft head",
  hoverSpin = true,
  class: cls = "",
} = Astro.props;
const src = `data:image/png;base64,${b64}`;
---

<div
  class:list={["mc-head", { "no-spin": !hoverSpin }, cls]}
  style={`--mc-size:${size}px;--mc-tex:url(${src});--mc-scale:${scale};`}
  role="img"
  aria-label={label}
>
  <div class="mc-stage">
    <div class="mc-cube head">
      <div class="face top"></div>
      <div class="face bot"></div>
      <div class="face front"></div>
      <div class="face back"></div>
      <div class="face left"></div>
      <div class="face right"></div>
    </div>
    <div class="mc-cube hat">
      <div class="face top"></div>
      <div class="face bot"></div>
      <div class="face front"></div>
      <div class="face back"></div>
      <div class="face left"></div>
      <div class="face right"></div>
    </div>
  </div>
</div>

<style>
  .mc-head {
    width: var(--mc-size);
    height: var(--mc-size);
    perspective: calc(var(--mc-size) * 6);
    display: inline-block;
    contain: layout;
  }
  .mc-stage {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(-18deg) rotateY(25deg) scale(var(--mc-scale));
    animation: mc-spin 5s linear infinite paused;
  }
  .mc-head:not(.no-spin):hover .mc-stage {
    animation-play-state: running;
  }
  @keyframes mc-spin {
    from { transform: rotateX(-18deg) rotateY(25deg) scale(var(--mc-scale)); }
    to   { transform: rotateX(-18deg) rotateY(385deg) scale(var(--mc-scale)); }
  }

  .mc-cube {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .mc-cube.hat { transform: scale(1.12); }

  .face {
    position: absolute;
    inset: 0;
    background-image: var(--mc-tex);
    background-repeat: no-repeat;
    background-size: calc(var(--mc-size) * 8);
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    backface-visibility: hidden;
  }

  /* HEAD: faces are 8×8 regions of the 64×64 skin texture.
     1 source px → var(--mc-size)/8 CSS px → background-size = 8 × mc-size. */
  .head > .front  { transform: translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -1) calc(var(--mc-size) * -1); }
  .head > .back   { transform: rotateY(180deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -3) calc(var(--mc-size) * -1); }
  .head > .right  { transform: rotateY(-90deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: 0 calc(var(--mc-size) * -1); }
  .head > .left   { transform: rotateY(90deg)  translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -2) calc(var(--mc-size) * -1); }
  .head > .top    { transform: rotateX(90deg)  translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -1) 0; }
  .head > .bot    { transform: rotateX(-90deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -2) 0; }

  /* HAT overlay: same regions offset by +32 source px (= +4 mc-size units). */
  .hat > .front   { transform: translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -5) calc(var(--mc-size) * -1); }
  .hat > .back    { transform: rotateY(180deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -7) calc(var(--mc-size) * -1); }
  .hat > .right   { transform: rotateY(-90deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -4) calc(var(--mc-size) * -1); }
  .hat > .left    { transform: rotateY(90deg)  translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -6) calc(var(--mc-size) * -1); }
  .hat > .top     { transform: rotateX(90deg)  translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -5) 0; }
  .hat > .bot     { transform: rotateX(-90deg) translateZ(calc(var(--mc-size) / 2));
                    background-position: calc(var(--mc-size) * -6) 0; }
</style>
