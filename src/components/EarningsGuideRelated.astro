---
interface Props {
  current?: "jobs" | "shop" | "stock" | "system" | "casino" | "events";
}
const { current } = Astro.props;

const items = [
  {
    key: "system",
    label: "SYSTEM",
    title: "経済・システム",
    lead: "残高確認、送金、ロビー移動など",
    href: "/earnings/system",
  },
  {
    key: "jobs",
    label: "JOBS",
    title: "仕事",
    lead: "専業を選び、対応する行動で自動収入。",
    href: "/earnings/jobs",
  },
  {
    key: "shop",
    label: "SHOP",
    title: "取引",
    lead: "村人ショップで買う・売る・仕入れる。",
    href: "/earnings/shop",
  },
  {
    key: "stock",
    label: "STOCK",
    title: "株",
    lead: "国営銘柄と会社株、日次配当と値動き。",
    href: "/earnings/stock",
  },

  {
    key: "casino",
    label: "CASINO",
    title: "カジノ",
    lead: "スロットとパチンコ、メダルを換金して一発。",
    href: "/earnings/casino",
  },
  {
    key: "events",
    label: "EVENTS",
    title: "イベント",
    lead: "建築コンテストなど、賞金と参加賞。",
    href: "/earnings/events",
  },
];
---

<section class="guide-related">
  <div class="earn-container">
    <div class="earn-section-eyebrow">
      <span class="label">OTHER GUIDES</span><span class="rule"></span>
    </div>
    <div class="guide-related-grid">
      {
        items.map((i) => (
          <a href={i.href} class:list={[current === i.key ? "is-current" : ""]}>
            <span class="lbl">{i.label}</span>
            <span class="ttl">{i.title}</span>
            <span class="lead">{i.lead}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
