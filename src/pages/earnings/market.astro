---
import EarningsLayout from "../../layouts/EarningsLayout.astro";
import EarningsGuideRelated from "../../components/EarningsGuideRelated.astro";
---

<EarningsLayout
  title="株式マーケット — ホロリス金策サバイバル 2026"
  description="ホロリス金策サバイバルの全上場銘柄の現在株価と値動きをリアルタイムに表示。国営株・会社株の株価チャートと騰落率をまとめて確認できます。"
  active="market"
>
  <section class="guide-hero">
    <div class="earn-container">
      <div class="guide-crumb">
        <a href="/earnings">TOP</a> / <a href="/earnings#guides">GUIDES</a> /
        <span class="current">MARKET</span>
      </div>
      <div class="guide-label">LIVE — STOCK MARKET</div>
      <h1 class="guide-title">株式マーケット。</h1>
      <div class="guide-underline"></div>
      <p class="guide-lead">
        上場中の全銘柄の現在株価と値動き。サーバーの市場データをそのまま表示しています。
      </p>
      <div class="market-meta">
        <span id="market-status" class="earn-mono"></span>
        <a class="market-guide-link" href="/earnings/stock"
          >株の遊び方ガイド →</a
        >
      </div>
    </div>
  </section>

  <section class="market-body earn-container">
    <p id="market-error" class="market-error" hidden></p>

    <div class="earn-section-eyebrow">
      <span class="label">LISTED STOCKS</span><span class="rule"></span>
    </div>
    <div class="market-toolbar">
      <div class="market-seg" role="group" aria-label="銘柄の種類で絞り込み">
        <button
          type="button"
          data-filter="all"
          class="is-active"
          aria-pressed="true">すべて</button
        >
        <button type="button" data-filter="NATIONAL" aria-pressed="false"
          >国営</button
        >
        <button type="button" data-filter="COMPANY" aria-pressed="false"
          >会社</button
        >
      </div>
    </div>

    <div class="market-table-wrap">
      <table class="market-table">
        <thead>
          <tr>
            <th scope="col">銘柄</th>
            <th scope="col" class="c-type">種別</th>
            <th scope="col" class="c-num">現在値</th>
            <th scope="col" class="c-num">前日比</th>
            <th scope="col" class="c-num">24h</th>
          </tr>
        </thead>
        <tbody id="market-rows">
          <tr class="market-skeleton">
            <td colspan="5">読み込み中…</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p id="market-empty" class="market-note" hidden>
      該当する銘柄がありません。
    </p>

    <div class="earn-section-eyebrow chart-eyebrow">
      <span class="label">PRICE CHART</span><span class="rule"></span>
    </div>

    <div class="chart-panel">
      <div class="chart-head">
        <div class="chart-id">
          <h2 id="market-chart-title" class="chart-title">—</h2>
          <span id="market-chart-type" class="chart-type"></span>
        </div>
        <div class="chart-quote">
          <span id="market-chart-price" class="chart-price earn-mono">—</span>
          <span id="market-chart-change" class="chart-change earn-mono"></span>
        </div>
      </div>

      <div class="chart-controls">
        <div class="market-seg" role="group" aria-label="表示期間">
          <button
            type="button"
            data-range="24h"
            class="is-active"
            aria-pressed="true">24時間</button
          >
          <button type="button" data-range="3d" aria-pressed="false">3日</button
          >
          <button type="button" data-range="all" aria-pressed="false"
            >全期間</button
          >
        </div>
        <div class="market-seg" role="group" aria-label="チャートの種類">
          <button
            type="button"
            data-mode="line"
            class="is-active"
            aria-pressed="true">ライン</button
          >
          <button type="button" data-mode="candle" aria-pressed="false"
            >ローソク足</button
          >
        </div>
      </div>

      <div class="chart-area">
        <div id="market-chart" class="chart-canvas"></div>
        <div id="market-tooltip" class="chart-tooltip" hidden></div>
        <p id="market-chart-empty" class="chart-empty" hidden>
          この期間に表示できる値動きがありません。
        </p>
      </div>

      <div id="market-chart-stats" class="chart-stats"></div>
    </div>

    <p class="market-note">
      ローソク足は1時間足です。株価は毎時の定時更新に加えて自然変動や特別イベントでも動くため、
      更新間隔は一定ではありません。時刻はすべて日本時間 (JST) です。
      チャート描画には <a
        href="https://www.tradingview.com/"
        rel="noopener noreferrer"
        target="_blank">TradingView</a
      > の Lightweight Charts™ を使用しています。
    </p>
  </section>

  <EarningsGuideRelated current="stock" />
</EarningsLayout>

<script>
  import "../../scripts/market.ts";
</script>

<!--
  Table rows, chart stats and the tooltip are built at runtime by
  scripts/market.ts, so they never receive Astro's scope attribute. The whole
  block is global; every selector below is namespaced to this page's markup
  and the stylesheet only ships with this page.
-->
<style is:global>
  /* `hidden` loses to any author `display`, so restate it for the flex boxes. */
  .chart-empty[hidden],
  .chart-tooltip[hidden],
  .market-error[hidden],
  .market-note[hidden] {
    display: none;
  }

  .market-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    margin-top: 22px;
    font-size: 12px;
  }
  #market-status {
    color: var(--earn-text-dim);
    letter-spacing: 0.08em;
  }
  .market-guide-link {
    color: var(--earn-gold);
    text-decoration: none;
    font-weight: 700;
  }
  .market-guide-link:hover {
    color: var(--earn-gold-bright);
  }

  .market-body {
    padding: 54px 48px 64px;
  }
  .market-error {
    border: 1px solid rgba(224, 87, 77, 0.5);
    background: rgba(224, 87, 77, 0.08);
    color: #f0a9a3;
    font-size: 13px;
    padding: 14px 18px;
    margin: 0 0 30px;
  }
  .market-note {
    color: var(--earn-text-dim);
    font-size: 12px;
    line-height: 1.9;
    margin: 20px 0 0;
  }

  /* ---- segmented controls ---- */
  .market-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 22px 0 18px;
  }
  .market-seg {
    display: inline-flex;
    border: 1px solid var(--earn-line-soft);
  }
  .market-seg button {
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--earn-line-soft);
    color: var(--earn-text-muted);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 9px 18px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }
  .market-seg button:last-child {
    border-right: 0;
  }
  .market-seg button:hover {
    color: var(--earn-gold);
  }
  .market-seg button.is-active {
    background: var(--earn-gold);
    color: #121212;
  }

  /* ---- table ---- */
  .market-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--earn-line);
  }
  .market-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }
  .market-table th {
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--earn-gold);
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--earn-line-soft);
    white-space: nowrap;
  }
  .market-table th.c-num {
    text-align: right;
  }
  .market-table td {
    padding: 13px 14px;
    border-bottom: 1px solid var(--earn-line-hair);
    font-size: 13.5px;
    vertical-align: middle;
  }
  .market-skeleton td {
    color: var(--earn-text-dim);
    font-size: 12.5px;
  }

  .market-row {
    cursor: pointer;
    transition: background 0.12s ease;
  }
  .market-row:hover,
  .market-row:focus-visible {
    background: rgba(201, 162, 39, 0.07);
    outline: none;
  }
  .market-row.is-selected {
    background: rgba(201, 162, 39, 0.13);
  }
  .market-row.is-selected .c-name .nm {
    color: var(--earn-gold-bright);
  }

  .c-name {
    min-width: 190px;
  }
  .c-name .nm {
    display: block;
    font-weight: 700;
  }
  .type-tag {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 3px 9px;
    border: 1px solid var(--earn-line-soft);
    color: var(--earn-text-muted);
    white-space: nowrap;
  }
  .type-tag.t-national {
    border-color: rgba(201, 162, 39, 0.5);
    color: var(--earn-gold);
  }
  .c-price,
  .c-change {
    text-align: right;
    white-space: nowrap;
  }
  .c-change .chg {
    display: block;
    font-size: 13px;
  }
  .c-change .chgp {
    display: block;
    font-size: 11px;
    opacity: 0.85;
  }
  .c-spark {
    text-align: right;
    width: 120px;
  }
  .c-spark .spark {
    display: block;
    margin-left: auto;
  }
  .spark-none {
    color: var(--earn-text-dim);
    font-size: 12px;
  }

  .is-up {
    color: #3fbf8f;
  }
  .is-down {
    color: #e0574d;
  }
  .is-flat {
    color: var(--earn-text-muted);
  }

  /* ---- chart ---- */
  .chart-eyebrow {
    margin-top: 52px;
  }
  .chart-panel {
    border: 1px solid var(--earn-line-soft);
    background: var(--earn-bg-2);
    margin-top: 22px;
  }
  .chart-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 14px 24px;
    padding: 22px 24px 18px;
    border-bottom: 1px solid var(--earn-line-hair);
  }
  .chart-title {
    font-size: 24px;
    font-weight: 900;
    margin: 0;
    line-height: 1.3;
  }
  .chart-type {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--earn-text-dim);
    letter-spacing: 0.14em;
  }
  .chart-quote {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .chart-price {
    font-size: 28px;
    font-weight: 700;
  }
  .chart-change {
    font-size: 13.5px;
    font-weight: 700;
  }

  .chart-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 16px 24px;
    border-bottom: 1px solid var(--earn-line-hair);
  }

  .chart-area {
    position: relative;
    padding: 12px 12px 4px;
  }
  .chart-canvas {
    height: 380px;
    width: 100%;
  }
  .chart-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    color: var(--earn-text-dim);
    font-size: 13px;
  }
  .chart-tooltip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    transform: translateY(-100%);
    background: rgba(11, 11, 11, 0.94);
    border: 1px solid var(--earn-line);
    padding: 8px 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    line-height: 1.6;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .chart-tooltip .tt-time {
    font-size: 10.5px;
    color: var(--earn-text-dim);
    letter-spacing: 0.06em;
  }
  .chart-tooltip b {
    font-size: 14px;
    font-weight: 700;
  }
  .chart-tooltip .tt-sub {
    font-size: 11px;
  }
  .chart-tooltip .tt-ohlc {
    font-size: 10.5px;
    color: var(--earn-text-muted);
  }

  .chart-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--earn-line-hair);
    border-top: 1px solid var(--earn-line-hair);
  }
  .chart-stats .stat {
    background: var(--earn-bg-2);
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .chart-stats .k {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--earn-text-dim);
  }
  .chart-stats .v {
    font-size: 14.5px;
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .market-body {
      padding: 40px 22px 52px;
    }
    .chart-head,
    .chart-controls {
      padding-left: 18px;
      padding-right: 18px;
    }
    .chart-price {
      font-size: 22px;
    }
    .chart-canvas {
      height: 300px;
    }
    .chart-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Long company names wrap to four lines if the type column keeps its width,
     so drop it here. The filter above the table and the chart header still
     say whether a stock is 国営 or 会社. */
  @media (max-width: 640px) {
    .market-table {
      min-width: 0;
    }
    .market-table .c-type {
      display: none;
    }
    .market-table th,
    .market-table td {
      padding: 12px 8px;
    }
    .c-name {
      min-width: 0;
    }
    .c-spark {
      width: 68px;
    }
    .c-spark .spark {
      width: 62px;
    }
  }
</style>
