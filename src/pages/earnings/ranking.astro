---
import EarningsLayout from "../../layouts/EarningsLayout.astro";
import EarningsGuideRelated from "../../components/EarningsGuideRelated.astro";
---

<EarningsLayout
  title="資産ランキング — ホロリス金策サバイバル 2026"
  description="ホロリス金策サバイバル参加者の所持金ランキングをリアルタイム表示。首位との差や参加者全体の資産状況をまとめて確認できます。"
  active="ranking"
>
  <section class="guide-hero">
    <div class="earn-container">
      <div class="guide-crumb">
        <a href="/earnings">TOP</a> / <a href="/earnings#guides">GUIDES</a> /
        <span class="current">RANKING</span>
      </div>
      <div class="guide-label">LIVE — ASSET RANKING</div>
      <h1 class="guide-title">資産ランキング。</h1>
      <div class="guide-underline"></div>
      <p class="guide-lead">
        参加者の所持金ランキング。サーバーの経済データをそのまま表示しています。
        集計対象は所持金(通貨残高)のみで、アイテムや建築物は含まれません。
      </p>
      <div class="rank-meta">
        <span id="rank-status" class="earn-mono"></span>
        <a class="rank-guide-link" href="/earnings/rules">集計ルールを見る →</a>
      </div>
    </div>
  </section>

  <section class="rank-body earn-container">
    <p id="rank-error" class="rank-error" hidden></p>

    <div id="rank-stats" class="rank-stats"></div>

    <div class="earn-section-eyebrow podium-eyebrow">
      <span class="label">TOP 3</span><span class="rule"></span>
    </div>
    <div id="rank-podium" class="rank-podium"></div>

    <div class="earn-section-eyebrow table-eyebrow">
      <span class="label">ALL PLAYERS</span><span class="rule"></span>
    </div>
    <div class="rank-toolbar">
      <input
        id="rank-search"
        class="rank-search"
        type="search"
        placeholder="プレイヤー名で絞り込み"
        aria-label="プレイヤー名で絞り込み"
        autocomplete="off"
      />
    </div>

    <div class="rank-table-wrap">
      <table class="rank-table">
        <thead>
          <tr>
            <th scope="col" class="c-pos">順位</th>
            <th scope="col">プレイヤー</th>
            <th scope="col" class="c-num">資産</th>
            <th scope="col" class="c-bar">首位比</th>
          </tr>
        </thead>
        <tbody id="rank-rows">
          <tr class="rank-skeleton">
            <td colspan="4">読み込み中…</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p id="rank-empty" class="rank-note" hidden>
      該当するプレイヤーがいません。
    </p>

    <p class="rank-note">
      残高は1分ごとに自動更新されます。順位はサーバーの現在残高そのままで、
      保有中の株やカジノメダルは含まれません(株は期間終了時に自動売却されて所持金になります)。
      時刻はすべて日本時間 (JST) です。
    </p>
  </section>

  <EarningsGuideRelated />
</EarningsLayout>

<script>
  import "../../scripts/ranking.ts";
</script>

<!--
  The stat cells, podium cards and table rows are built at runtime by
  scripts/ranking.ts, so they never receive Astro's scope attribute. The whole
  block is global; every selector below is namespaced to this page's markup
  and the stylesheet only ships with this page.
-->
<style is:global>
  /* `hidden` loses to any author `display`, so restate it for the flex boxes. */
  .rank-error[hidden],
  .rank-note[hidden] {
    display: none;
  }

  .rank-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    margin-top: 22px;
    font-size: 12px;
  }
  #rank-status {
    color: var(--earn-text-dim);
    letter-spacing: 0.08em;
  }
  .rank-guide-link {
    color: var(--earn-gold);
    text-decoration: none;
    font-weight: 700;
  }
  .rank-guide-link:hover {
    color: var(--earn-gold-bright);
  }

  .rank-body {
    padding: 54px 48px 64px;
  }
  .rank-error {
    border: 1px solid rgba(224, 87, 77, 0.5);
    background: rgba(224, 87, 77, 0.08);
    color: #f0a9a3;
    font-size: 13px;
    padding: 14px 18px;
    margin: 0 0 30px;
  }
  .rank-note {
    color: var(--earn-text-dim);
    font-size: 12px;
    line-height: 1.9;
    margin: 20px 0 0;
  }

  /* ---- summary stats ---- */
  .rank-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--earn-line-hair);
    border: 1px solid var(--earn-line-hair);
  }
  .rank-stats .stat {
    background: var(--earn-bg-2);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .rank-stats .k {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--earn-text-dim);
  }
  .rank-stats .v {
    font-size: 16px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- podium ---- */
  .podium-eyebrow,
  .table-eyebrow {
    margin-top: 52px;
  }
  .rank-podium {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--earn-line-soft);
    border: 1px solid var(--earn-line-soft);
    margin-top: 22px;
  }
  .podium-card {
    background: var(--earn-bg-2);
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .podium-card .pod-pos {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--earn-text-dim);
  }
  .podium-card .pod-name {
    font-size: 21px;
    font-weight: 900;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .podium-card .pod-amount {
    font-size: 17px;
    font-weight: 700;
    color: var(--earn-text-muted);
  }
  .podium-card.p-1 {
    background: rgba(201, 162, 39, 0.1);
  }
  .podium-card.p-1 .pod-pos,
  .podium-card.p-1 .pod-amount {
    color: var(--earn-gold);
  }
  .podium-card.p-1 .pod-name {
    color: var(--earn-gold-bright);
  }

  /* ---- toolbar ---- */
  .rank-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 22px 0 18px;
  }
  .rank-search {
    appearance: none;
    background: transparent;
    border: 1px solid var(--earn-line-soft);
    color: var(--earn-text);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 14px;
    min-width: 260px;
  }
  .rank-search::placeholder {
    color: var(--earn-text-dim);
  }
  .rank-search:focus {
    outline: none;
    border-color: var(--earn-gold);
  }

  /* ---- table ---- */
  .rank-table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--earn-line);
  }
  .rank-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }
  .rank-table th {
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--earn-gold);
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--earn-line-soft);
    white-space: nowrap;
  }
  .rank-table th.c-num {
    text-align: right;
  }
  .rank-table td {
    padding: 13px 14px;
    border-bottom: 1px solid var(--earn-line-hair);
    font-size: 13.5px;
    vertical-align: middle;
  }
  .rank-skeleton td {
    color: var(--earn-text-dim);
    font-size: 12.5px;
  }

  .rank-table .c-pos {
    width: 64px;
    color: var(--earn-text-dim);
    font-weight: 700;
  }
  .rank-table .c-player .nm {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .rank-table .c-amount {
    text-align: right;
    white-space: nowrap;
    font-weight: 700;
  }
  .rank-table .c-bar {
    width: 200px;
  }
  .rank-row.is-top .c-pos,
  .rank-row.is-top .c-amount {
    color: var(--earn-gold);
  }
  .rank-row.is-top1 {
    background: rgba(201, 162, 39, 0.08);
  }
  .rank-row.is-top1 .c-player .nm {
    color: var(--earn-gold-bright);
  }

  .rank-table .bar {
    display: block;
    height: 6px;
    background: rgba(232, 226, 212, 0.1);
  }
  .rank-table .bar > i {
    display: block;
    height: 100%;
    background: rgba(201, 162, 39, 0.55);
  }
  .rank-row.is-top .bar > i {
    background: var(--earn-gold);
  }
  .rank-table .bar-pct {
    display: block;
    margin-top: 5px;
    font-size: 10.5px;
    color: var(--earn-text-dim);
  }

  @media (max-width: 820px) {
    .rank-body {
      padding: 40px 22px 52px;
    }
    .rank-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .rank-podium {
      grid-template-columns: 1fr;
    }
  }

  /* The share bar is the first thing worth dropping on a narrow screen: the
     amount column already carries the ranking. */
  @media (max-width: 640px) {
    .rank-table {
      min-width: 0;
    }
    .rank-table .c-bar {
      display: none;
    }
    .rank-table th,
    .rank-table td {
      padding: 12px 8px;
    }
    .rank-table .c-pos {
      width: 44px;
    }
    .rank-search {
      min-width: 0;
      width: 100%;
    }
  }
</style>
