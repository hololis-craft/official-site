---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideCredits from "../../components/GuideCredits.astro";
import discsData from "../../data/discs.json";

const LOOT_LABEL: Record<string, string> = {
  "chests/abandoned_mineshaft": "廃坑",
  "chests/village/village_desert_house": "砂漠の村の家",
  "chests/village/village_plains_house": "平原の村の家",
  "chests/village/village_savanna_house": "サバンナの村の家",
  "chests/village/village_snowy_house": "雪の村の家",
  "chests/village/village_taiga_house": "タイガの村の家",
};

function formatDuration(sec: number) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${m}:${String(s).padStart(2, "0")}`;
}

const discs = discsData.discs;

const footerLinks = [
  { href: "/", label: "トップ" },
  { href: "/guide", label: "ガイド" },
  { href: "/systems", label: "システム" },
];
---
<BaseLayout title="レコード一覧 — ホロリスくらふと" footerLinks={footerLinks}>
  <header class="dhero" data-screen-label="レコードヒーロー">
    <img src="/assets/miko-suisei-shrine-with-gomoku.jpg" alt="" />
    <div class="dhero-tint"></div>
    <div class="dhero-inner">
      <div class="crumb"><a href="/">トップ</a> &nbsp;/&nbsp; <a href="/guide">ガイド</a> &nbsp;/&nbsp; レコード</div>
      <h1>レコード一覧<br />全 {discs.length} 種類</h1>
      <p>歴代 hololive EXPO / fes. のテーマソングをはじめ、ホロライブ関連曲のアレンジをレコード化。入手場所もまとめてチェック。</p>
    </div>
  </header>

  <section class="band records-band">
    <div class="sec">
      <div class="disc-grid">
        {discs.map((d) => (
          <article class="disc-card">
            <div class="disc-art">
              <div class="disc-vinyl" style={`background-image:url(data:image/png;base64,${d.texB64});`}></div>
            </div>
            <div class="disc-body">
              <div class="disc-meta-top">
                <span class="disc-num">#{String(d.modelData).padStart(2, "0")}</span>
                <span class="disc-time">{formatDuration(d.durationSec)}</span>
              </div>
              <h3 class="disc-title">{d.title}</h3>
              <p class="disc-author">{d.author}</p>

              <div class="disc-loot">
                {d.lootTables.length > 0 ? (
                  <>
                    <span class="disc-loot-label">入手場所</span>
                    <div class="disc-loot-items">
                      {d.lootTables.map((lt) => (
                        <span class="loot-chip">
                          <b>{LOOT_LABEL[lt.table] ?? lt.table}</b>
                          <em>重み {lt.weight}</em>
                        </span>
                      ))}
                    </div>
                  </>
                ) : (
                  <span class="disc-loot-none">入手は別の経路（イベント・店舗等）</span>
                )}
              </div>

              <div class="disc-flags">
                {d.creeperDrop ? (
                  <span class="flag flag-creeper">Creeper Drop ✓</span>
                ) : (
                  <span class="flag flag-no">Creeper Drop なし</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <GuideCredits>
    <h3>データ出典</h3>
    <ul>
      <li>レコード定義：リソースパック内 <code>jext.json</code>（<a href="https://hololiscraft-resources.f0reach.me/hololiscraft-merged-pack.zip" rel="noopener">merged-pack</a>）</li>
      <li>jext (Jukebox Extension) ライブラリを使用</li>
    </ul>
    <h3>楽曲</h3>
    <p>収録曲はすべてホロライブ関連の楽曲をベースに、サーバー有志がレコード向けに編集・調整したものです。各曲の原作・アレンジ情報は順次整備中。心当たりのある方は Discord までご連絡ください。</p>
    <small>※ 「重み」は同一チェストでの相対的な出現確率の重み付け。値が同じでも別レコードと並んだときの当選率は分母により変わります。</small>
  </GuideCredits>
</BaseLayout>

<style>
  .dhero { position: relative; height: 320px; overflow: hidden; }
  .dhero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dhero-tint { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,20,38,.45) 0%, rgba(10,20,38,.92) 100%); }
  :global([data-theme="light"]) .dhero-tint { background: linear-gradient(180deg, rgba(58,43,34,.3) 0%, rgba(58,43,34,.78) 100%); }
  .dhero-inner { position: relative; z-index: 2; max-width: 1180px; margin: 0 auto; padding: 0 44px; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .crumb { color: rgba(255,255,255,.78); font-size: 13px; font-weight: 700; }
  .crumb a { color: var(--accent); }
  .dhero h1 { font-size: 46px; font-weight: 900; color: #fff; line-height: 1.12; }
  .dhero p { color: rgba(255,255,255,.85); font-weight: 700; font-size: 14.5px; max-width: 620px; line-height: 1.8; }

  .records-band { background: var(--bg); }

  .disc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .disc-card {
    background: var(--surface-grad);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .18s, border-color .18s;
  }
  .disc-card:hover { transform: translateY(-3px); border-color: var(--border-strong); }

  .disc-art {
    aspect-ratio: 16 / 10;
    background: radial-gradient(ellipse at center, rgba(255,180,84,.18) 0%, rgba(10,20,38,.6) 65%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .disc-art::before {
    content: ""; position: absolute; inset: 0;
    background:
      repeating-radial-gradient(circle at center, rgba(255,255,255,.04) 0 2px, transparent 2px 5px);
    opacity: .8;
  }
  .disc-vinyl {
    position: relative;
    width: 130px; height: 130px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
    image-rendering: pixelated;
    animation: vinyl-spin 22s linear infinite;
    filter: drop-shadow(0 6px 12px rgba(0,0,0,.5));
  }
  @keyframes vinyl-spin { to { transform: rotate(360deg); } }

  .disc-body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 6px; }
  .disc-meta-top { display: flex; justify-content: space-between; font-family: var(--font-en); font-size: 12px; font-weight: 700; color: var(--accent); }
  .disc-num { letter-spacing: .08em; }
  .disc-time { color: var(--text-soft); }
  .disc-title { font-size: 19px; font-weight: 900; color: var(--text); margin-top: 4px; line-height: 1.35; }
  .disc-author { font-size: 13px; color: var(--text-muted); font-weight: 700; }

  .disc-loot { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--border); }
  .disc-loot-label {
    display: block;
    font-family: var(--font-en);
    font-size: 11px; font-weight: 800;
    color: var(--text-soft);
    letter-spacing: .12em;
    margin-bottom: 8px;
  }
  .disc-loot-items { display: flex; flex-wrap: wrap; gap: 7px; }
  .loot-chip {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .loot-chip b { font-weight: 800; color: var(--text); }
  .loot-chip em { font-style: normal; font-family: var(--font-en); font-size: 10.5px; color: var(--accent); font-weight: 700; }
  .disc-loot-none { font-size: 12.5px; color: var(--text-soft); font-style: italic; }

  .disc-flags { margin-top: 14px; display: flex; gap: 6px; flex-wrap: wrap; }
  .flag {
    font-size: 11px; font-weight: 800;
    padding: 4px 9px; border-radius: 999px;
  }
  .flag-creeper { background: rgba(34,197,94,.16); color: #4ADE80; border: 1px solid rgba(34,197,94,.3); }
  .flag-no { background: var(--surface-2); color: var(--text-soft); border: 1px solid var(--border); }

  code { font-family: var(--font-mono); font-size: 12.5px; background: var(--surface-2); padding: 2px 6px; border-radius: 4px; }

  @media (max-width: 760px) {
    .dhero { height: 260px; }
    .dhero-inner { padding: 0 22px; }
    .dhero h1 { font-size: 30px; }
    .disc-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
